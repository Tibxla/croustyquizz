# Copier dans .env et choisir un mot de passe avant le premier démarrage.
# .env est ignoré par Git. Ne jamais y mettre de données réelles dans un commit.
POSTGRES_DB=croustyquizz
POSTGRES_USER=croustyquizz
POSTGRES_PASSWORD=
# Version de l'image sans le v du tag Git ; main suit le dernier build de main.
CROUSTYQUIZZ_VERSION=main
